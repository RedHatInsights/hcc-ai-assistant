FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS uv-tool

FROM registry.access.redhat.com/ubi9/python-312@sha256:5a0471c98fc10017d011c16b7615cd1d7f157d796f89eb4900ca0dc6c87384cf
USER root
COPY --from=uv-tool /usr/local/bin/uv /usr/local/bin/uv

WORKDIR /app/agent-service
COPY agent-service/pyproject.toml agent-service/uv.lock ./
RUN --mount=type=cache,id=hcc-agent-uv,target=/root/.cache/uv \
  UV_CACHE_DIR=/root/.cache/uv UV_HTTP_TIMEOUT=120 UV_CONCURRENT_DOWNLOADS=4 UV_LINK_MODE=copy \
  uv sync --python /usr/bin/python3.12 --locked --no-dev --no-install-project --no-python-downloads
ENV PATH="/app/agent-service/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1
COPY agent-service/turn.py agent-service/conversations.py agent-service/discovered_tools.py agent-service/agent_card.py ./
WORKDIR /app
COPY proxy.py lightspeed-stack.yaml ./
USER 1001
ENTRYPOINT []
CMD ["uvicorn", "turn:create_app", "--factory", "--app-dir", "/app/agent-service", "--host", "127.0.0.1", "--port", "8080", "--no-access-log"]